#!/bin/sh
# Bumps the version from the commit message and amends it into the same commit:
#   feat -> minor, fix/perf -> patch, "!" or "BREAKING CHANGE:" -> major.
# See CLAUDE.md.

[ -n "$BRM_VERSION_BUMP" ] && exit 0 # our own amend below

top=$(git rev-parse --show-toplevel) || exit 0
gitdir=$(git rev-parse --git-dir) || exit 0
cd "$top" || exit 0

# Not while git replays commits: they already carry their bump.
for f in rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD MERGE_HEAD BISECT_LOG; do
  [ -e "$gitdir/$f" ] && exit 0
done

command -v node >/dev/null 2>&1 || { echo "post-commit: node not found, version not bumped" >&2; exit 0; }
git rev-parse -q --verify HEAD~1 >/dev/null || exit 0 # first commit

msgfile="$gitdir/BRM_COMMIT_MSG"
git log -1 --format=%B HEAD >"$msgfile"
level=$(node scripts/version.ts level "$msgfile")
rm -f "$msgfile"
[ "$level" = none ] && exit 0

# Already bumped in this commit (an amend, or a bump by hand): leave it.
version_of() { git show "$1:package.json" 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log(JSON.parse(s).version??"")}catch{console.log("")}})'; }
[ "$(version_of HEAD)" != "$(version_of HEAD~1)" ] && exit 0

files=$(node scripts/version.ts files)
# Do not sweep unrelated, unstaged edits of these files into the commit.
# shellcheck disable=SC2086
if ! git diff --quiet -- $files; then
  echo "post-commit: version files have uncommitted changes, version not bumped." >&2
  echo "  Commit or stash them, then run: pnpm version:bump $level && git commit --amend --no-edit" >&2
  exit 0
fi

version=$(node scripts/version.ts bump "$level") || exit 0
# shellcheck disable=SC2086
git add -- $files
BRM_VERSION_BUMP=1 git commit --amend --no-edit --no-verify -q || exit 0
echo "Version $version ($level)"

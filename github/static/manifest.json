{
  "manifest_version": 3,
  "name": "Margin - Declutter GitHub homepage",
  "version": "1.2.1",
  "description": "A GitHub homepage with your repositories, your organizations and where you pushed last, without the clutter.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["home.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Margin settings",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  }
}
